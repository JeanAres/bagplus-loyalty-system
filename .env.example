# ==============================================================================
# Bag+ Environment Variables Template
# Instruções:
# 1. Copie este arquivo: cp .env.example .env
# 2. Preencha os valores abaixo no seu novo arquivo .env
# 3. NUNCA versione o arquivo .env real no Git
# ==============================================================================

# ============================================
# AMBIENTE
# ============================================
# Valores: local | staging | production
ENVIRONMENT=local
DEBUG=true

# ============================================
# API / SERVIDOR
# ============================================
API_HOST=0.0.0.0
API_PORT=8000

# ============================================
# BANCO DE DADOS
# ============================================
# SQLite (Padrão para desenvolvimento local)
DATABASE_URL=sqlite:///./data/bagplus.db

# Exemplo para PostgreSQL (Produção/Staging):
# DATABASE_URL=postgresql://usuario:senha@localhost:5432/nome_do_banco

# ============================================
# SEGURANÇA (OBRIGATÓRIO)
# --------------------------------------------
# ATENÇÃO: Gere chaves seguras e únicas para cada ambiente.
# Sugestão: rode 'openssl rand -hex 32' no terminal para gerar.
# ============================================
SECRET_KEY=
JWT_SECRET_KEY=
ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=30  # não usado diretamente — expiração definida por role no código

# ============================================
# CREDENCIAIS DE DESENVOLVIMENTO (INITIAL SEED)
# --------------------------------------------
# Estas credenciais podem ser usadas para criar um usuário 
# admin inicial quando ENVIRONMENT=local.
# Mantenha vazio em produção.
# ============================================
DEV_ADMIN_USERNAME=admin
DEV_ADMIN_PASSWORD=

# ============================================
# SERVIÇOS EXTERNOS (OPCIONAL)
# ============================================
# Exemplo: Sentry, AWS S3, SMTP Email
# SENTRY_DSN=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=